<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playbackControlsBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#006874"
    android:elevation="8dp"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonShuffle"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:checkable="true"
        android:minHeight="48dp"
        android:text="@string/playback_shuffle_off"
        android:textAllCaps="false"
        android:textColor="@color/playback_toggle_text"
        app:backgroundTint="@color/playback_toggle_background"
        app:rippleColor="#40FFFFFF"
        app:strokeColor="@android:color/white"
        app:strokeWidth="1dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonRepeat"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:checkable="true"
        android:minHeight="48dp"
        android:text="@string/playback_repeat_off"
        android:textAllCaps="false"
        android:textColor="@color/playback_toggle_text"
        app:backgroundTint="@color/playback_toggle_background"
        app:rippleColor="#40FFFFFF"
        app:strokeColor="@android:color/white"
        app:strokeWidth="1dp" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="2dp">

    <!-- Always visible above splash images; tap shows author splash -->
    <TextView
        android:id="@+id/aboutHeaderAuthor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/about_author_line"
        android:textColor="#004F58"
        android:textSize="16sp"
        android:textStyle="bold"
        app:autoSizeMaxTextSize="16sp"
        app:autoSizeMinTextSize="12sp"
        app:autoSizeStepGranularity="0.5sp"
        app:autoSizeTextType="uniform" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="360dp">

        <ScrollView
            android:id="@+id/aboutTextScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <TextView
                android:id="@+id/aboutText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="1dp"
                android:padding="4dp"
                android:textColor="#212121"
                android:textSize="12.5sp" />
        </ScrollView>

        <ImageView
            android:id="@+id/aboutSplashImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/splash_content_description"
            android:scaleType="centerCrop"
            android:visibility="gone" />
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/aboutOk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="0dp"
        android:insetBottom="0dp"
        android:minHeight="36dp"
        android:text="@string/about_ok"
        android:textAllCaps="false"
        android:textSize="14sp" />
</LinearLayout>
